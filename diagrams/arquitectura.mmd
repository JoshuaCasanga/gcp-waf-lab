%% Arquitectura WAAP Lab en GCP (versión simplificada)
flowchart LR
    user([Usuario])
    attacker([Atacante<br/>SQLi · XSS · flood])

    subgraph edge[Google Cloud Edge]
        lb[Load Balancer global<br/>IP estática · TLS 1.2+<br/>HTTP → HTTPS]
        armor{{Cloud Armor<br/>WAF OWASP CRS<br/>rate limit · geo}}
    end

    blocked[/403 · 429/]

    subgraph vpc[VPC · southamerica-west1]
        mig[MIG regional · 2–4 VMs<br/>Juice Shop<br/>sin IP pública]
        nat[Cloud NAT<br/>solo salida]
    end

    iap[IAP<br/>SSH admin]
    obs[(Logging +<br/>Monitoring)]

    user -->|HTTPS| lb
    attacker -.-> lb
